#!/usr/bin/env bash
# Fling — tray panel (macOS Fling port).
#   fling            open the panel (launches Fling if not running)
#   fling tray       start only the tray icon
#   fling cast-tab   send current Firefox tab to TV
#   fling clip       send link from clipboard
#   fling quit       exit
#   fling help       how-to-use guide
#   fling tui ...    terminal controller (fling-tui)
APP="$HOME/.local/share/fling/fling_app.py"
PY="$HOME/.local/share/fling/venv/bin/python"
case "${1:-}" in
  tui) shift; exec "$HOME/.local/bin/fling-tui" "$@" ;;
  -h|--help) sed -n 2,8p "$0"; exit ;;
esac
# first instance stays in background; later calls just pass the command on
exec setsid -f "$PY" "$APP" "${1:-show}" >>"$HOME/.cache/fling/app.log" 2>&1

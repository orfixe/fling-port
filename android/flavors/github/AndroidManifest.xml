<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub APK only: Fling updates itself from the newest release (Updater). The Play build
     has neither the permission nor the receiver: Play updates the app itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- the download in the background (UpdateService) and the daily check after a reboot (UpdateJob) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver android:name=".Updater$Result" android:exported="false" />
        <service
            android:name=".UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>

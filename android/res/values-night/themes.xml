<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FlingTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/acc_blue</item>
        <item name="android:colorPrimary">#000000</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Android 12+: the launch splash animates the icon (bubbles rise, the dot lights up) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_fling_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBackground">@color/page</item>
    </style>
    <color name="page">#000000</color>
</resources>
